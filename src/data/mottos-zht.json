    {
     "text": "二人同心，其利斷金。",
     "source": "《周易·繫辭上》",
     "modern": "找對搭子，難活也能一起啃下來。"
    },
    {
     "text": "投我以桃，報之以李。",
     "source": "《詩經·大雅·抑》",
     "modern": "人家幫過你，記得回個人情。"
    },
    {
     "text": "君子和而不同。",
     "source": "《論語·子路》",
     "modern": "可以不同意，但別把天聊死。"
    },
    {
     "text": "知彼知己，百戰不殆。",
     "source": "《孫子·謀攻》",
     "modern": "談之前，先把對方要啥摸清楚。"
    }
   ]
  },
  "生門": {
   "seal": "生財有道",
   "mottos": [
    {
     "text": "不義而富且貴，於我如浮雲。",
     "source": "《論語·述而》",
     "modern": "來路不正的錢，再多也別碰。"
    },
    {
     "text": "不積跬步，無以至千里。",
     "source": "《荀子·勸學》",
     "modern": "小單也是單，先開張再說。"
    },
    {
     "text": "天下熙熙，皆為利來；天下攘攘，皆為利往。",
     "source": "《史記·貨殖列傳》",
     "modern": "想賺錢不丟人，大家都在搞。"
    },
    {
     "text": "人棄我取，人取我與。",
     "source": "《史記·貨殖列傳》",
     "modern": "大家都擠的賽道，未必輪得到你。"
    },
    {
     "text": "凡事豫則立，不豫則廢。",
     "source": "《禮記·中庸》",
     "modern": "先算清成本，再談能賺多少。"
    },
    {
     "text": "一年之計，莫如樹穀；十年之計，莫如樹木。",
     "source": "《管子·權修》",
     "modern": "別只盯月薪，也種點長期的東西。"
    },
    {
     "text": "儉，德之共也；侈，惡之大也。",
     "source": "《左傳·莊公二十四年》",
     "modern": "用不上的訂閱先停，錢包會謝你。"
    },
    {
