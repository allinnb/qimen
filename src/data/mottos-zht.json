  "傷門": {
   "seal": "自強不息",
   "mottos": [
    {
     "text": "天行健，君子以自強不息。",
     "source": "《周易·乾·象傳》",
     "modern": "力氣大的日子，拿去運動別拿去吵架。"
    },
    {
     "text": "苟日新，日日新，又日新。",
     "source": "《禮記·大學》",
     "modern": "今天比昨天多做一組，也算贏。"
