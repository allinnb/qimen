 "doors": {
  "開門": {
   "seal": "開物成務",
   "mottos": [
    {
     "text": "三人行，必有我師焉。",
     "source": "《論語·述而》",
     "modern": "開會別光說，聽聽別人的路子。"
    },
    {
     "text": "獨學而無友，則孤陋而寡聞。",
     "source": "《禮記·學記》",
     "modern": "一個人悶頭幹，容易越幹越窄。"
    },
    {
     "text": "言必信，行必果。",
     "source": "《論語·子路》",
     "modern": "答應的事按時交，比啥話術都好使。"
    },
    {
     "text": "己所不欲，勿施於人。",
     "source": "《論語·衛靈公》",
     "modern": "自己嫌煩的流程，別甩給合作方。"
